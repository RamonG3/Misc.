              <Transform target="width" value="clamp(1 - ([HEART_RATE] - 50) / 150, 0.06, 1) * 122"/>
            </Rectangle>
          </PartDraw>
          <PartText x="113" y="262" width="110" height="26">
            <Text align="CENTER">
              <Font family="SYNC_TO_DEVICE" size="17" weight="BOLD" color="#FFFFFF">
