<?xml version="1.0" encoding="utf-8"?>
<!--
  RuneWatch: a RuneScape 3 inspired watch face in Watch Face Format v1 (Wear OS 4+).

  Canvas is 450x450 and the system scales it to the real screen.
  Images are drawn by tools/generate_assets.py. The two long Agility expressions are
  generated by tools/xp_expressions.py (1 step = 1 XP on the real level curve).

    Life points  = heart rate (rest heals you, sprinting does not)
    Prayer       = battery
    Adrenaline   = progress to your step goal (100% = ultimate ready)
    Agility XP   = steps today
-->
<WatchFace width="450" height="450" clipShape="CIRCLE">
  <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
  <Metadata key="PREVIEW_TIME" value="10:42:00"/>

  <UserConfigurations>
    <ListConfiguration id="skin" displayName="skin_label" screenReaderText="skin_label" defaultValue="0">
      <ListOption id="0" displayName="skin_steel" screenReaderText="skin_steel"/>
      <ListOption id="1" displayName="skin_legacy" screenReaderText="skin_legacy"/>
      <ListOption id="2" displayName="skin_abyss" screenReaderText="skin_abyss"/>
      <ListOption id="3" displayName="skin_obsidian" screenReaderText="skin_obsidian"/>
    </ListConfiguration>
  </UserConfigurations>

  <!-- Sizes must match tools/generate_assets.py (it prints these when it runs). -->
  <BitmapFonts>
    <BitmapFont name="gold_digits">
      <Character name="0" resource="gold_0" width="73" height="100"/>
      <Character name="1" resource="gold_1" width="47" height="100"/>
      <Character name="2" resource="gold_2" width="70" height="100"/>
      <Character name="3" resource="gold_3" width="64" height="100"/>
      <Character name="4" resource="gold_4" width="70" height="100"/>
      <Character name="5" resource="gold_5" width="63" height="100"/>
      <Character name="6" resource="gold_6" width="71" height="100"/>
      <Character name="7" resource="gold_7" width="62" height="100"/>
      <Character name="8" resource="gold_8" width="68" height="100"/>
      <Character name="9" resource="gold_9" width="71" height="100"/>
      <Character name=":" resource="gold_colon" width="30" height="100"/>
    </BitmapFont>
    <BitmapFont name="amb_digits">
      <Character name="0" resource="amb_0" width="73" height="100"/>
      <Character name="1" resource="amb_1" width="47" height="100"/>
      <Character name="2" resource="amb_2" width="70" height="100"/>
      <Character name="3" resource="amb_3" width="64" height="100"/>
      <Character name="4" resource="amb_4" width="70" height="100"/>
      <Character name="5" resource="amb_5" width="63" height="100"/>
      <Character name="6" resource="amb_6" width="71" height="100"/>
      <Character name="7" resource="amb_7" width="62" height="100"/>
      <Character name="8" resource="amb_8" width="68" height="100"/>
      <Character name="9" resource="amb_9" width="71" height="100"/>
      <Character name=":" resource="amb_colon" width="30" height="100"/>
    </BitmapFont>
  </BitmapFonts>

  <Scene backgroundColor="#000000">

    <!-- ============================================================ background skin -->
    <Group name="background" x="0" y="0" width="450" height="450">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <ListConfiguration id="skin">
        <ListOption id="0">
          <PartImage x="0" y="0" width="450" height="450">
            <Image resource="bg_steel"/>
          </PartImage>
        </ListOption>
        <ListOption id="1">
          <PartImage x="0" y="0" width="450" height="450">
            <Image resource="bg_legacy"/>
          </PartImage>
        </ListOption>
        <ListOption id="2">
          <PartImage x="0" y="0" width="450" height="450">
            <Image resource="bg_abyss"/>
          </PartImage>
        </ListOption>
        <ListOption id="3">
          <PartDraw x="0" y="0" width="450" height="450">
            <Rectangle x="0" y="0" width="450" height="450">
              <Fill color="#050505"/>
            </Rectangle>
          </PartDraw>
        </ListOption>
      </ListConfiguration>
    </Group>

    <PartImage name="bezel" x="0" y="0" width="450" height="450">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <Image resource="bezel"/>
    </PartImage>

    <!-- ============================================================ date -->
    <PartImage name="date_plaque" x="133" y="44" width="184" height="44">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <Image resource="plaque_date"/>
    </PartImage>
    <PartText name="date" x="139" y="50" width="172" height="32">
      <Variant mode="AMBIENT" target="alpha" value="170"/>
      <Text align="CENTER">
        <Font family="cinzel_bold" size="19" color="#F2D58A">
          <Template>%s %s %s<Parameter expression="[DAY_OF_WEEK_S]"/><Parameter expression="[DAY]"/><Parameter expression="[MONTH_S]"/></Template>
        </Font>
      </Text>
    </PartText>

    <!-- ============================================================ Agility XP tracker (steps) -->
