      <PartImage x="97" y="262" width="126" height="26">
        <Image resource="track_half"/>
      </PartImage>
      <Condition>
        <Expressions>
          <Expression name="hasHeartRate"><![CDATA[[HEART_RATE] > 0]]></Expression>
        </Expressions>
        <Compare expression="hasHeartRate">
