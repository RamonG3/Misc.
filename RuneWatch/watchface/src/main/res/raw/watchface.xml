      <TimeText format="h:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="450" height="100">
        <Variant mode="AMBIENT" target="alpha" value="0"/>
        <BitmapFont family="gold_digits" size="100"/>
      </TimeText>
    </DigitalClock>
    <DigitalClock x="0" y="140" width="450" height="100">
      <TimeText format="h:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="450" height="100" alpha="0">
        <Variant mode="AMBIENT" target="alpha" value="255"/>
        <BitmapFont family="amb_digits" size="100"/>
      </TimeText>
    </DigitalClock>

    <!-- ============================================================ action bar: LP / Prayer / Adrenaline -->
    <Group name="action_bar" x="0" y="0" width="450" height="450">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <PartImage x="60" y="246" width="330" height="88">
        <Image resource="plaque_bars"/>
      </PartImage>

